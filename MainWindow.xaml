<Controls:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" Title="Pivots and Scripts" Width="1400" Height="900" MinWidth="1024" MinHeight="700" WindowStartupLocation="CenterScreen" TitleCharacterCasing="Normal" ShowIconOnTitleBar="False" BorderThickness="1" GlowBrush="{DynamicResource MahApps.Brushes.Accent}" NonActiveGlowBrush="{DynamicResource MahApps.Brushes.Accent}">
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml"/>
   <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml"/>
   <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Steel.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <!-- Contrast overrides of the MahApps theme brushes. One value passes in both themes:
       #7F7F7F is 4.0:1 on white and 3.8:1 on #252525 (control borders need 3:1);
       white title text is 7.0:1 on #595959 (the inactive title bar). -->
  <SolidColorBrush x:Key="MahApps.Brushes.TextBox.Border" Color="#7F7F7F"/>
  <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle.NonActive" Color="#595959"/>
  <!-- The one button template and the one button style. Every Button of the window takes ThemedButtonStyle or a style that is based on it.
       No color literal is allowed here: the colors come from the MahApps theme resources, so the same markup works in the dark and the light theme.
       Hover and keyboard focus show the theme foreground as border color. Pressed swaps the theme foreground and the theme background.
       A disabled button that has no local colors shows MahApps.Brushes.Gray.MouseOver text (4.5:1 or more in both themes) and a Gray2 border, because the MahApps disabled state fades the text below 4.5:1.
       Accepted limit: SuiteCommon sets a local Foreground, Background and BorderBrush on the sidebar buttons, and a local value beats the style trigger. The disabled state of those four buttons is what SuiteCommon paints. The fix belongs in app-packager-suite. -->
  <ControlTemplate x:Key="ThemedButtonTemplate" TargetType="Button">
   <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
    <ContentPresenter Name="Cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
    </Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True">
     <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
    </Trigger>
    <Trigger Property="IsPressed" Value="True">
     <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
     <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="ThemedButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square}">
   <Setter Property="Template" Value="{StaticResource ThemedButtonTemplate}"/>
   <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="Padding" Value="10,5"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <!-- The sidebar buttons. SuiteCommon paints their background, border and (in the light theme) their white text from code. -->
  <Style x:Key="ViewButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
   <Setter Property="Height" Value="42"/>
   <Setter Property="Margin" Value="8,3"/>
   <Setter Property="Padding" Value="12,0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="OptionsButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewButtonStyle}"/>
  <!-- Selected and highlighted items: white text (IdealForeground) on the highlight blue, in both themes.
       Each item sets its own Foreground, so a selected parent does not pass white text to its children. -->
  <Style x:Key="ThemedListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
   <Setter Property="Controls:ItemHelper.DisabledForegroundBrush" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
     <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ThemedComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource MahApps.Styles.ComboBoxItem}">
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True">
     <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
     <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
    </Trigger>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
     <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ThemedDataGridRow" TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
     <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ThemedDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MahApps.Styles.DataGrid}">
   <Setter Property="RowStyle" Value="{StaticResource ThemedDataGridRow}"/>
  </Style>
  <Style x:Key="GridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
     <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}"><Setter Property="Margin" Value="3"/></Style>
  <Style x:Key="TabHeaderText" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style>
 </ResourceDictionary></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Grid.Column="0">
   <StackPanel DockPanel.Dock="Top" Margin="14"><TextBlock Text="Pivots and Scripts" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="Realtime endpoint workbench" FontSize="12" Margin="0,6" Foreground="{DynamicResource MahApps.Brushes.Gray1}"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="14"><Separator/><TextBlock x:Name="txtThemeLabel" Text="Dark Theme" FontWeight="Bold" Margin="0,8"/><Controls:ToggleSwitch x:Name="toggleTheme" IsOn="True" OnContent="" OffContent="" ToolTip="Switch between the dark and the light theme."/><TextBlock Text="AppPackager Suite" Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray1}"/></StackPanel>
   <DockPanel><StackPanel DockPanel.Dock="Top"><Button x:Name="btnPivot" Content="CMPivot" Style="{StaticResource ViewButtonStyle}"/><Button x:Name="btnScript" Content="PowerShell" Style="{StaticResource ViewButtonStyle}"/><Button x:Name="btnHistory" Content="Open Session" Style="{StaticResource OptionsButtonStyle}"/><Button x:Name="btnOptions" Content="Options" Style="{StaticResource OptionsButtonStyle}"/><TextBlock Text="Library" FontSize="14" FontWeight="Bold" Margin="14,18,0,6"/><TextBox x:Name="libraryFilter" Margin="8,3" ToolTip="Filter the library by file name."/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Button x:Name="btnOpen" Content="Open Query or Script" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnSave" Content="Save Editor File" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnSaveSession" Content="Save Session" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnNewSession" Content="New Session" Style="{StaticResource ThemedButtonStyle}"/></StackPanel><ListBox x:Name="library" Margin="8" DisplayMemberPath="BaseName" ItemContainerStyle="{StaticResource ThemedListBoxItemStyle}"/></DockPanel>
  </DockPanel>
  <Border Grid.Column="1" Background="{DynamicResource MahApps.Brushes.Gray1}"/>
  <Grid Grid.Column="2" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="230"/><RowDefinition Height="5"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0"><TextBlock x:Name="heading" Text="CMPivot" FontSize="24" FontWeight="Bold"/><WrapPanel Margin="0,10,0,5"><TextBlock x:Name="connectionInfo" Text="Connection not set. Open Options." VerticalAlignment="Center" Margin="3,0,10,0"/><StackPanel x:Name="connectionPair" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="Site Code" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,6,0"/><TextBlock x:Name="txtSiteCode" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock Text="SMS Provider" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="txtSmsProvider" VerticalAlignment="Center" Margin="0,0,10,0"/></StackPanel><Button x:Name="btnConnect" Content="Test Connection" Style="{StaticResource ThemedButtonStyle}"/></WrapPanel></StackPanel>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="targetKind" SelectedIndex="0" Margin="3" ItemContainerStyle="{StaticResource ThemedComboBoxItemStyle}"><ComboBoxItem Content="Collection"/><ComboBoxItem Content="Device"/><ComboBoxItem Content="Pattern"/><ComboBoxItem Content="List"/></ComboBox><TextBox Grid.Column="1" x:Name="targetInput" Height="58" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="Enter a collection name or ID, a device name, a wildcard pattern, or a list of device names."/><Button Grid.Column="2" x:Name="btnImport" Content="Import List" Style="{StaticResource ThemedButtonStyle}"/><Button Grid.Column="3" x:Name="btnResolve" Content="Resolve Targets" Style="{StaticResource ThemedButtonStyle}"/></Grid>
   <DockPanel Grid.Row="2" Margin="3,6"><Button x:Name="btnTargets" Content="View Snapshot" DockPanel.Dock="Right" Style="{StaticResource ThemedButtonStyle}"/><TextBlock x:Name="targetSummary" Text="Resolve targets before running." VerticalAlignment="Center"/></DockPanel>
   <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><TextBlock x:Name="editorLabel" Text="Query Editor" FontWeight="Bold" VerticalAlignment="Center" Margin="3"/><Button x:Name="btnFind" Content="Find Next" Style="{StaticResource ThemedButtonStyle}"/><TextBox x:Name="findText" Width="90" ToolTip="Text to find in the editor."/><TextBox x:Name="replaceText" Width="90" ToolTip="Text that replaces each match."/><Button x:Name="btnReplace" Content="Replace All" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnCheck" Content="Check Syntax" Style="{StaticResource ThemedButtonStyle}"/><TextBlock x:Name="editorPosition" Text="Ln 1, Col 1" VerticalAlignment="Center" Margin="10,0"/></WrapPanel>
    <editor:TextEditor Grid.Row="1" x:Name="editor" ShowLineNumbers="True" FontFamily="Consolas" FontSize="13" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource MahApps.Brushes.ThemeBackground}" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" Margin="3"/>
    <WrapPanel Grid.Row="2"><Button x:Name="btnRun" Content="Run CMPivot" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnStop" Content="Stop Waiting" IsEnabled="False" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnSubmit" Content="Submit Script for Approval" Visibility="Collapsed" Style="{StaticResource ThemedButtonStyle}"/><TextBlock x:Name="guidLabel" Text="Script GUID" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/><TextBox x:Name="scriptGuid" Width="255" Visibility="Collapsed" ToolTip="GUID of the approved Configuration Manager script."/><Button x:Name="btnParameters" Content="Parameters" Visibility="Collapsed" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnSiteScripts" Content="Site Scripts" Visibility="Collapsed" ToolTip="List, approve, deny or remove the scripts on the site." Style="{StaticResource ThemedButtonStyle}"/></WrapPanel>
   </Grid>
   <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch"/>
   <WrapPanel Grid.Row="5"><TextBox x:Name="resultFilter" Width="220" ToolTip="Search all result columns."/><Button x:Name="btnCsv" Content="Export CSV" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnJson" Content="Export JSON" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnCopy" Content="Copy PowerShell" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnGrid" Content="Out-GridView" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnSelectionScript" Content="Selection to Script" Style="{StaticResource ThemedButtonStyle}"/><Button x:Name="btnSelectionPivot" Content="Selection to Pivot" Style="{StaticResource ThemedButtonStyle}"/></WrapPanel>
   <TabControl Grid.Row="6" x:Name="resultTabs" Controls:HeaderedControlHelper.HeaderFontSize="13"><TabItem><TabItem.Header><TextBlock Text="Results" Style="{StaticResource TabHeaderText}" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/></TabItem.Header><DataGrid x:Name="results" Style="{StaticResource ThemedDataGridStyle}" CellStyle="{StaticResource GridCellStyle}" IsReadOnly="True" AutoGenerateColumns="True" SelectionMode="Extended" CanUserAddRows="False" CanUserReorderColumns="True" FrozenColumnCount="1" EnableRowVirtualization="True"/></TabItem><TabItem><TabItem.Header><TextBlock Text="Devices" Style="{StaticResource TabHeaderText}" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/></TabItem.Header><DataGrid x:Name="devices" Style="{StaticResource ThemedDataGridStyle}" CellStyle="{StaticResource GridCellStyle}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/></TabItem><TabItem><TabItem.Header><TextBlock Text="Raw" Style="{StaticResource TabHeaderText}" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/></TabItem.Header><TextBox x:Name="raw" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem><TabItem.Header><TextBlock Text="Pipeline" Style="{StaticResource TabHeaderText}" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/></TabItem.Header><DataGrid x:Name="pipeline" Style="{StaticResource ThemedDataGridStyle}" CellStyle="{StaticResource GridCellStyle}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/></TabItem></TabControl>
   <TextBlock Grid.Row="7" x:Name="status" Text="Ready. Open a library item to begin." TextWrapping="Wrap" Margin="3,10,3,0"/>
  </Grid>
 </Grid>
</Controls:MetroWindow>
